---
import { getEntry, render } from 'astro:content';
import Entry from '../layouts/Entry.astro';

const manifesto = await getEntry('entries', 'manifesto');
if (!manifesto) throw new Error('Manifesto entry missing — preface required for /');
const { Content } = await render(manifesto);
---

<Entry
  slug={manifesto.id}
  title={manifesto.data.title}
  date={manifesto.data.date}
  city={manifesto.data.city}
  summary={manifesto.data.summary}
  lang={manifesto.data.lang}
>
  <Content />
</Entry>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'tr' | 'en';
}

const { title, description, lang = 'tr' } = Astro.props;
const siteName = 'ogulcan.dev';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBFAF7" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="page-header">
      <a href="/" class="running-head">{siteName}</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="page-footer">
      <p class="colophon">{year} — set in Newsreader</p>
    </footer>
  </body>
</html>

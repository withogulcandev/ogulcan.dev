---
import Base from './Base.astro';
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
  title: string;
  date: Date;
  city?: string;
  summary?: string;
  lang?: 'tr' | 'en';
}

const { slug, title, date, city, summary, lang } = Astro.props;
const iso = date.toISOString().slice(0, 10);
const [y, m, d] = iso.split('-');
const pretty = `${y} · ${m} · ${d}`;

const chapters = (await getCollection('entries'))
  .filter((e) => e.data.status === 'published')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Base title={title} description={summary} lang={lang}>
  <div class="book-layout">
    <aside class="book-nav" aria-label="Bölümler">
      <p class="nav-label">Bölümler</p>
      <ol>
        {chapters.map((e) => (
          <li>
            <a href={`/${e.id}`} class={e.id === slug ? 'active' : ''}>
              {e.data.title}
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <article class="book-main">
      <header>
        <h1>{title}</h1>
        <p class="entry-meta">
          <time datetime={iso}>{pretty}</time>
          {city && <><span class="dot">·</span>{city}</>}
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</Base>

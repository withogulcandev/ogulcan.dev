---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  city?: string;
  summary?: string;
  lang?: 'tr' | 'en';
}

const { title, date, city, summary, lang } = Astro.props;
const iso = date.toISOString().slice(0, 10);
const [y, m, d] = iso.split('-');
const pretty = `${y} · ${m} · ${d}`;
---

<Base title={title} description={summary} lang={lang}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="entry-meta">
        <time datetime={iso}>{pretty}</time>
        {city && <><span class="dot">·</span>{city}</>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

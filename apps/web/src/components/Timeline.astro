---
import { TYPE_GLYPH, groupChronologically, type AtlasEntry } from '../lib/atlas';

interface Props {
  entries: AtlasEntry[];
}

const { entries } = Astro.props;
const groups = groupChronologically(entries);
---

<nav class="timeline" aria-label="Journey timeline">
  <div class="timeline-brand">
    <a href="/" class="timeline-brand-title">ogulcan.dev</a>
    <p class="timeline-brand-sub">a modern travelogue</p>
  </div>
  <ol class="timeline-root">
    {
      groups.map((g, gi) => (
        <li
          class="timeline-country"
          data-country={g.country}
          data-active={gi === 0 ? '' : undefined}
        >
          <span class="timeline-country-label">{g.country}</span>
          <ol class="timeline-cities">
            {g.cities.map((c, ci) => (
              <li
                class="timeline-city"
                data-city={c.city ?? ''}
                data-active={gi === 0 && ci === 0 ? '' : undefined}
              >
                {c.city && <span class="timeline-city-label">{c.city}</span>}
                <ol class="timeline-entries">
                  {c.entries.map((e, ei) => (
                    <li
                      class="timeline-entry"
                      data-slug={e.slug}
                      data-type={e.type}
                      data-active={gi === 0 && ci === 0 && ei === 0 ? '' : undefined}
                    >
                      <a href={`#${e.slug}`}>
                        <span class="timeline-glyph" aria-hidden="true">
                          {TYPE_GLYPH[e.type]}
                        </span>
                        <span class="timeline-title">{e.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
</nav>
